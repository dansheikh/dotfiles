Host *
     ForwardAgent no
     ForwardX11 no
     ForwardX11Trusted yes
     GatewayPorts yes
     Port 22
     Protocol 2
     ServerAliveInterval 60
     ServeraliveCountMax 30

Host dansheikh.github.com
     Hostname github.com
     IdentityFile ~/.ssh/id_rsa_dansheikh
     PreferredAuthentications publickey
     User git

Host dan-sheikh.gitlab.com
     Hostname gitlab.com
     IdentityFile ~/.ssh/id_ed25519_dan-sheikh
     PreferredAuthentications publickey
     User git
