    config = get_config('which')
  })

  use({
    'folke/trouble.nvim',
    requires = 'nvim-tree/nvim-web-devicons'
  })

  use({
    'goolord/alpha-nvim',
    config = get_config('alpha')
  })

  use({
    'hrsh7th/nvim-cmp',
    requires = { { 'hrsh7th/cmp-buffer' },
      { 'hrsh7th/cmp-nvim-lsp' },
      { 'hrsh7th/cmp-nvim-lua' },
      { 'hrsh7th/cmp-path' },
      { 'jose-elias-alvarez/null-ls.nvim',
